<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F2336"
    android:fitsSystemWindows="true">

    <!-- Header: name, status, timer -->
    <androidx.constraintlayout.widget.Guideline
    android:id="@+id/gTop"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintGuide_percent="0.18"/>
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gTop"
        app:layout_constraintVertical_bias="0.2">

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/unknownName"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Rachel" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Connected" />

        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="00:19" />
    </LinearLayout>

    <!-- android:foreground="?attr/selectableItemBackgroundBorderless" -->
    <!-- Avatar (initial or default user icon) -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="100dp"
        android:background="@drawable/bg_avatar_circle"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Default user icon (shown when number/no name) -->
        <ImageView
            android:id="@+id/ivAvatarIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="28dp"
            android:tint="@color/white"
            app:srcCompat="@drawable/ic_user" />

        <!-- First initial (visible when name has letters) -->
        <TextView
            android:id="@+id/tvInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="56sp"
            android:visibility="gone"
            tools:text="R" />
    </FrameLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/actionsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_call_bottom_panel" 
        android:paddingStart="20dp"              
        android:paddingEnd="20dp"
        android:paddingTop="30dp"   
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Output -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnAudioDevice"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_rect_blue"
                android:padding="12dp"
                android:tint="@android:color/white"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_volume_up_white_24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Speaker"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mic -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnMute"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_rect_green"
                android:padding="18dp"
                android:tint="@android:color/white"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_mic_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mute"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- More (SalesCaptain) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnSalescaptain"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_rect_newgreen"
                android:padding="12dp"
                android:tint="@android:color/white"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/outline_dashboard_customize_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="More"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- End -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnHangUp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_btn_rect_red"
                android:padding="18dp"
                android:tint="@android:color/white"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_phone_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="End"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
